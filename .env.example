# === DISCORD ===
# Token do bot - https://discord.com/developers/applications => App => Bot => Reset Token
DISCORD_TOKEN=SEU_TOKEN_AQUI

# Client ID da aplicação - OAuth2 > General > Client ID
DISCORD_CLIENT_ID=SEU_CLIENT_ID_AQUI

# === AUTORIZAÇÃO DE SERVIDORES ===
# Lista de IDs de servidores AUTORIZADOS (separados por vírgula)
# O bot vai SAIR AUTOMATICAMENTE de qualquer servidor que não estiver nesta lista.
# Deixe vazio para bloquear TODOS os servidores (nenhum autorizado).
DISCORD_ALLOWED_GUILDS=123456789012345678,987654321098765432

# === CONFIGURAÇÕES DAS GUILDS ===
# Esses valores são FALLBACK opcionais — usados caso a guild NÃO tenha configurado
# via /setchannelalpha, /setchannelpheno, /setchannelswarm, /setrolealpha, etc.
# Se deixar vazio, a guild PRECISA configurar pelos comandos slash.
DISCORD_ALPHA_CHANNEL_ID=
DISCORD_PHENO_CHANNEL_ID=
DISCORD_SWARM_CHANNEL_ID=
DISCORD_ALPHA_ROLE_ID=
DISCORD_PHENO_ROLE_ID=
DISCORD_SWARM_ROLE_ID=

# Opcional - ID do servidor para registrar comandos instantaneamente
# EM PRODUÇÃO: deixe vazio para registrar comandos globalmente
# (comandos globais levam até 1h para aparecer em servidores novos)
DISCORD_GUILD_ID=

# === SCRAPING ===
ALPHA_SITE_URL=https://alpha.pokemmotools.org/
SCRAPE_INTERVAL_MS=30000

# === SERVIDOR HTTP ===
SERVER_PORT=3000

# === CACHE ===
CACHE_TTL_MS=300000

# === LOGS ===
LOG_LEVEL=info
